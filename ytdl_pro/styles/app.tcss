/* Tema escuro estilo Claude Code */
$primary: #ff6b35;
$secondary: #7c4dff;
$success: #00e676;
$surface: #0d0d0d;
$s-dark-1: #141414;
$s-dark-2: #1e1e1e;
$border: #2a2a2a;
$text: #f5f5f5;
$muted: #8e8e8e;

Screen { background: $surface; color: $text; }

#main-container { layout: horizontal; }

/* Sidebar */
#sidebar {
    width: 26;
    background: $s-dark-1;
    border-right: solid $border;
}

.sidebar-titulo {
    color: $primary;
    text-style: bold;
    text-align: center;
    padding: 1 0;
}

.sidebar-version { color: $muted; text-align: center; }
.sidebar-divider { color: $border; text-align: center; }
.sidebar-spacer { height: 1; }

.sidebar-btn {
    width: 100%;
    background: transparent;
    border: none;
    color: $muted;
    text-align: left;
    padding: 1 2;
}

.sidebar-btn:hover { background: $s-dark-2; color: $text; }
.sidebar-btn.selected { background: $s-dark-2; color: $primary; border-left: solid $primary; }
.sidebar-sair { color: $muted; }

/* Content */
#content {
    width: 100%;
    padding: 2 3;
}

#tela-content { layout: vertical; }

.content-label { color: $muted; padding: 1 0; }
.content-titulo { color: $primary; text-style: bold; padding: 1 0; }
.content-spacer { height: 1; }

#opcoes, #opcoes-playlist { layout: horizontal; height: auto; }
#qualidade-box, #formato-box { width: 20; padding: 0 1; }
.option-label { color: $muted; }

.url-input {
    width: 100%;
    border: solid $border;
    background: $s-dark-2;
}

.btn-download {
    width: 100%;
    height: 3;
    background: $primary;
    color: black;
}

.btn-download:hover { background: $primary; }

#progresso { height: 3; margin: 1 0; }
.log-area { background: $s-dark-2; border: solid $border; height: 18; }

.config-item { color: $text; padding: 0 2; }

Header { background: $primary; color: black; }
Footer { background: $s-dark-1; color: $muted; }

DataTable { margin: 1 0; }
Select { background: $s-dark-2; border: solid $border; }