/* YTDL-PRO - Tema Simples */

$bg: #0a0a0a;
$bg-dark: #080808;
$bg-card: #0d0d0d;
$border: #161616;
$text: #c8c8c8;
$text-dim: #888888;
$primary: #ff4500;
$secondary: #ff6b35;
$success: #00ff87;

Screen { background: $bg; color: $text; }

#header { height: 3; background: $bg-card; }
#header-logo { color: $primary; }
#header-title { color: $secondary; }
#header-status { color: $text-dim; }

#layout { layout: horizontal; }

#sidebar { width: 16; background: $bg-dark; border-right: solid $border; }
#sidebar-brand { height: 5; }

#brand-name { color: $primary; }
#brand-version { color: #444; }
#brand-separator { color: #333; }

.nav-btn { width: 100%; background: transparent; color: $text-dim; }
.nav-btn:hover { background: #111; color: $text; }
.nav-btn.-active { background: #111; color: $secondary; }

#content { width: 100%; background: $bg-dark; }
.hidden { display: none; }

.page-title { color: $primary; }
.page-subtitle { color: $text-dim; }

#url-box { height: 5; }
.input-label { color: $secondary; }
#url-input { background: #111; width: 100%; }

#options-grid { layout: horizontal; height: auto; }
.option-card { width: 1; }

.option-title { color: $secondary; }
Select { background: #111; width: 100%; }

#download-btn-area { layout: horizontal; }

.btn-primary { background: $primary; color: #000; }
.btn-secondary { background: #111; color: $text-dim; }

#progress-panel { height: 6; }
#progress-title { color: $text; }
#meta-canal, #meta-qualidade, #meta-velocidade, #meta-eta { color: $text-dim; }
#meta-velocidade { color: $secondary; }
#progress-status { color: $secondary; }

#log-panel { height: 10; }
#log { background: #111; }

#footer { height: 2; background: $bg-card; }
.footer-key { color: $primary; }
.footer-label { color: #444; }

.config-section { height: auto; }
.config-section-title { color: $secondary; }
.config-row { layout: horizontal; height: 3; }
.config-label { width: 12; color: $text-dim; }
.config-input { background: #111; width: 100%; }

.config-switch-row { layout: horizontal; height: 3; }
Switch { background: #111; }

.perfil-card { height: 5; }
.perfil-card.-ativo { border: solid $primary; }
.perfil-nome { color: $text; }
.perfil-desc { color: $text-dim; }

#sobre-box { height: auto; text-align: center; }
.sobre-logo { color: $primary; }
.sobre-linha { color: #444; }
.sobre-item-label { color: $text-dim; }
.sobre-item-value { color: $text; }

DataTable { background: $bg-card; }
ScrollableContainer { background: $bg-dark; }